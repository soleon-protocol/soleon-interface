# Public Solana network configuration. These values are bundled in the browser.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Public token and launch allocation addresses. Leave empty until they exist.
# NEXT_PUBLIC_SOLEON_MINT=
# NEXT_PUBLIC_MAINTENANCE_FEE_RECEIVER=
# NEXT_PUBLIC_CREATOR_ALLOCATION_WALLET=
# NEXT_PUBLIC_GENESIS_DISTRIBUTION_WALLET=
# NEXT_PUBLIC_GENESIS_DISTRIBUTION_TOKEN_ACCOUNT=
# NEXT_PUBLIC_GENESIS_SELECTION_RULES_URL=
# NEXT_PUBLIC_GENESIS_REPORTS_URL=

# Public staking addresses. Leave empty until staking is deployed.
# NEXT_PUBLIC_SOLEON_PROGRAM_ID=
# NEXT_PUBLIC_SOLEON_CONFIG_PDA=
# NEXT_PUBLIC_SOLEON_STAKING_VAULT=
# NEXT_PUBLIC_SOLEON_REWARD_VAULT=
# NEXT_PUBLIC_SOLEON_FEE_VAULT=
# NEXT_PUBLIC_STAKING_REPOSITORY_URL=

# Public web state.
# pre_launch | genesis_active | markets_live | staking_live | immutable
NEXT_PUBLIC_SOLEON_PHASE=pre_launch
NEXT_PUBLIC_JUPITER_ENABLED=false
NEXT_PUBLIC_STAKING_ENABLED=false
NEXT_PUBLIC_STAKING_TRANSACTIONS_ENABLED=false
NEXT_PUBLIC_MAINTENANCE_ACTIONS_ENABLED=false
NEXT_PUBLIC_TEST_SHORT_BURN=false

# Public dates.
NEXT_PUBLIC_GENESIS_LAUNCH_DATE=2026-08-31T12:00:00Z
NEXT_PUBLIC_ESTIMATED_MAINNET_LAUNCH=2026-08-24T12:00:00Z

# Server-only shared cache and rate-limit storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only fee index RPC/indexer.
HELIUS_RPC_URL=

# Server-only verified DEX market registry.
# Leave empty until the corresponding on-chain addresses have been published
# and reviewed. Changes are exposed through the shared Redis market cache.
SOLEON_MANIFEST_MARKET_ADDRESS=
SOLEON_MANIFEST_TRADE_URL=
SOLEON_JUPITER_ROUTE_URL=
# JSON array. Each pool may include:
# id, dex, pair, verification, poolAddress, tradeUrl, priceUsd, tvlUsd,
# volume24hUsd, fee, liquidityControl, sourceName and sourceUrl.
SOLEON_COMMUNITY_POOLS_JSON=[]
